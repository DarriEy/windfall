&share
 wrf_core = 'ARW', max_dom = 3, start_date = 3*'2022-01-01_00:00:00',
 end_date = 3*'2022-01-02_12:00:00', interval_seconds = 21600,
/
&geogrid
 parent_id         = 1, 1, 2,
 parent_grid_ratio = 1, 3, 3,
 i_parent_start    = 1, 33, 30,
 j_parent_start    = 1, 33, 30,
 e_we              = 100, 121, 121,
 e_sn              = 100, 121, 121,
 geog_data_res     = 'default','default','default',
 dx = 9000, dy = 9000,
 map_proj = 'lambert',
 ref_lat = 65.85, ref_lon = -18.2,
 truelat1 = 64.0, truelat2 = 67.0, stand_lon = -18.2,
 geog_data_path = '/BUILD_WRF/WPS_GEOG',
/
&ungrib
 out_format = 'WPS', prefix = 'FILE',
/
&metgrid
 fg_name = 'FILE',
/
